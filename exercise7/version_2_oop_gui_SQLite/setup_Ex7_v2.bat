@echo off
:: Включаем поддержку UTF-8 в консоли Windows для корректного отображения русского языка
chcp 65001 > nul
title Развертывание приложения фермерских рынков

echo ======================================================================
echo       АВТОМАТИЗИРОВАННОЕ РАЗВЕРТЫВАНИЕ И КОНФИГУРИРОВАНИЕ ПРОЕКТА
echo ======================================================================
echo.

:: Шаг 1: Проверка наличия Python в системе
echo [1/4] Проверка окружения Python...
python --version >nul 2>&1
if %errorlevel% neq 0 (
    echo [КРИТИЧЕСКАЯ ОШИБКА]: Python не найден в переменной окружения PATH!
    echo Пожалуйста, установите Python перед запуском развертывания.
    pause
    exit /b
)

:: Шаг 2: Создание виртуального окружения на уровень выше (в корне проекта)
echo [2/4] Проверка виртуального окружения (..\\.venv)...
if not exist "..\.venv" (
    echo Создание нового изолированного окружения .venv в корне проекта...
    python -m venv "..\.venv"
) else (
    echo Виртуальное окружение .venv уже существует в корне.
)

:: Шаг 3: Активация venv из корневой папки и обновление pip
echo [3/4] Активация окружения и подготовка компонентов...
call "..\.venv\Scripts\activate.bat"
python -m pip install --upgrade pip

:: Шаг 4: Первоначальный импорт данных в СУБД (запуск напрямую, так как мы уже в папке с кодом)
echo [4/4] Запуск первоначальной миграции данных в СУБД SQLite...
python migrations.py

echo.
echo ======================================================================
echo  Развертывание завершено успешно! База данных data/markets.db готова.
echo ======================================================================
echo.
pause
